# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The publishable (or legacy "anon") key — safe to be public
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# The secret (or legacy "service_role") key — server only, never share it
SUPABASE_SECRET_KEY=sb_secret_...

# Shared PIN choir members enter once per device. Leave empty for no PIN.
# Changing it makes everyone enter the new one.
CHOIR_PIN=

# Shown in the header and on the home-screen icon
NEXT_PUBLIC_CHOIR_NAME=Citadel Choir

# So "upcoming" flips over at local midnight
CHOIR_TIMEZONE=America/Chicago
