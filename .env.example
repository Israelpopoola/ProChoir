# Supabase → Project Settings → API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Shown in the header and on the home-screen icon
NEXT_PUBLIC_CHOIR_NAME=ProChoir

# Your church's time zone, so "upcoming" flips over at local midnight
# Examples: America/New_York, Europe/London, Africa/Lagos
CHOIR_TIMEZONE=UTC
